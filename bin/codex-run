#!/bin/zsh
# codex-run — fallback wrapper around `codex exec`
#
# See README for full docs. Ships as a single zsh script by design (MVP v0.1).

emulate -L zsh
set -uo pipefail

VERSION="0.1.0"
DEFAULT_MODELS="gpt-5.6-sol,gpt-5.6-luna,gpt-5.6-terra,gpt-5.5"
DEFAULT_TIMEOUT=600

usage() {
  cat <<'EOF'
codex-run — fallback wrapper around `codex exec`

Usage:
  codex-run [OPTIONS] [codex-exec-args...] PROMPT

Options:
  --models a,b,c    Comma-separated model fallback chain
                    (env CODEX_MODELS; default: gpt-5.6-sol,gpt-5.6-luna,gpt-5.6-terra,gpt-5.5)
  --out FILE        Write attempt #1 to FILE (retries always use mktemp)
  --timeout SEC     Per-model timeout in seconds
                    (env CODEX_TIMEOUT; default: 600)
  -h, --help        Show this help
  --version         Show version

Any flag not listed above is forwarded verbatim to `codex exec`
(e.g. --skip-git-repo-check, -c key=val). PROMPT is always the last
positional argument. Use `--` to force everything after it to be
treated as `codex exec` args + trailing PROMPT.

Output contract:
  stdout : on success, absolute path of the successful attempt's output file (one line)
  stderr : progress, per-attempt result, final summary
  exit   : 0 on success; on total failure, the last attempted model's exit code

Trace files (per attempt) are never deleted so failures remain diagnosable.
EOF
}

log() { print -u2 -r -- "$*"; }

MODELS="${CODEX_MODELS:-$DEFAULT_MODELS}"
TIMEOUT_SEC="${CODEX_TIMEOUT:-$DEFAULT_TIMEOUT}"
OUT_FILE=""
PROMPT=""
typeset -a PASSTHROUGH POSITIONAL
PASSTHROUGH=()
POSITIONAL=()
saw_double_dash=0

while (( $# > 0 )); do
  case "$1" in
    --models)    (( $# >= 2 )) || { log "codex-run: --models requires a value"; exit 2; }
                 MODELS="$2"; shift 2 ;;
    --models=*)  MODELS="${1#--models=}"; shift ;;
    --out)       (( $# >= 2 )) || { log "codex-run: --out requires a value"; exit 2; }
                 OUT_FILE="$2"; shift 2 ;;
    --out=*)     OUT_FILE="${1#--out=}"; shift ;;
    --timeout)   (( $# >= 2 )) || { log "codex-run: --timeout requires a value"; exit 2; }
                 TIMEOUT_SEC="$2"; shift 2 ;;
    --timeout=*) TIMEOUT_SEC="${1#--timeout=}"; shift ;;
    -h|--help)   usage; exit 0 ;;
    --version)   print -- "codex-run $VERSION"; exit 0 ;;
    --)          saw_double_dash=1; shift
                 while (( $# > 0 )); do POSITIONAL+=("$1"); shift; done
                 break ;;
    *)           POSITIONAL+=("$1"); shift ;;
  esac
done

if (( ${#POSITIONAL[@]} == 0 )); then
  log "codex-run: error: PROMPT is required"
  log ""
  usage >&2
  exit 2
fi

# Last positional is PROMPT; the rest are forwarded to `codex exec`.
PROMPT="${POSITIONAL[-1]}"
if (( ${#POSITIONAL[@]} > 1 )); then
  PASSTHROUGH=("${POSITIONAL[@]:0:$((${#POSITIONAL[@]}-1))}")
fi

if [[ -z "$PROMPT" ]]; then
  log "codex-run: error: PROMPT is empty"
  exit 2
fi

if ! [[ "$TIMEOUT_SEC" == <-> ]]; then
  log "codex-run: --timeout must be a positive integer (got: $TIMEOUT_SEC)"
  exit 2
fi

typeset -a MODEL_LIST
MODEL_LIST=("${(@s:,:)MODELS}")
# strip empties
MODEL_LIST=("${(@)MODEL_LIST:#}")
if (( ${#MODEL_LIST[@]} == 0 )); then
  log "codex-run: error: no models in fallback chain"
  exit 2
fi

# Regex for retryable failures. Matches on either non-zero exit output or
# occasionally on exit=0 output when codex prints an error but returns 0.
FAIL_PATTERNS='(Selected model is at capacity|Too Many Requests|quota exceeded|rate.?limit|(^|[^0-9])429([^0-9]|$))'

typeset -a ATTEMPT_LOG
ATTEMPT_LOG=()

CODEX_BIN="${CODEX_BIN:-codex}"
if ! command -v "$CODEX_BIN" >/dev/null 2>&1; then
  log "codex-run: error: '$CODEX_BIN' not found in PATH (set CODEX_BIN to override)"
  exit 127
fi

last_exit=0
last_path=""
success=0

for i in {1..${#MODEL_LIST[@]}}; do
  MODEL="${MODEL_LIST[$i]}"
  safe_model="${MODEL//[^A-Za-z0-9._-]/_}"

  if [[ -n "$OUT_FILE" && $i -eq 1 ]]; then
    out_path="$OUT_FILE"
    : > "$out_path" 2>/dev/null || { log "codex-run: cannot write to --out '$OUT_FILE'"; exit 2; }
  else
    out_path="$(mktemp -t "codex-run-${safe_model}-XXXXXX")" \
      || { log "codex-run: mktemp failed"; exit 2; }
  fi
  case "$out_path" in
    /*) ;;
    *)  out_path="$PWD/$out_path" ;;
  esac

  log "[attempt $i/${#MODEL_LIST[@]}] model=$MODEL out=$out_path timeout=${TIMEOUT_SEC}s"

  timeout "${TIMEOUT_SEC}" "$CODEX_BIN" exec -m "$MODEL" "${PASSTHROUGH[@]}" -- "$PROMPT" >"$out_path" 2>&1
  ec=$?
  last_exit=$ec
  last_path="$out_path"

  reason=""
  if (( ec == 0 )); then
    if grep -Eiq -- "$FAIL_PATTERNS" "$out_path"; then
      reason="fail-pattern in output (exit=0)"
    else
      success=1
      ATTEMPT_LOG+=("  [$i] $MODEL: OK -> $out_path")
      log "  -> OK"
      break
    fi
  elif (( ec == 124 )); then
    reason="timeout after ${TIMEOUT_SEC}s"
  elif grep -Eiq -- "$FAIL_PATTERNS" "$out_path"; then
    reason="fail-pattern (exit=$ec)"
  else
    reason="exit=$ec"
  fi

  ATTEMPT_LOG+=("  [$i] $MODEL: FAIL ($reason) trace=$out_path")
  log "  -> FAIL: $reason"
done

log ""
log "attempts:"
for line in "${ATTEMPT_LOG[@]}"; do log "$line"; done

if (( success == 1 )); then
  print -r -- "$last_path"
  exit 0
fi

log ""
log "codex-run: all ${#MODEL_LIST[@]} model(s) failed"
exit "$last_exit"
